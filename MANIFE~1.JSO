{
  "manifest_version": 3,
  "name": "YTM Duplicate Cleaner",
  "version": "1.0.0",
  "description": "Trova ed elimina i duplicati nelle playlist di YouTube Music usando l'API interna (niente click sul DOM).",
  "host_permissions": ["https://music.youtube.com/*"],
  "permissions": ["scripting", "activeTab"],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YTM Duplicate Cleaner"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
